root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
indent_size = 4

# Namespaces and usings
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false

# 'var' — Jellyfin house style prefers var when the type is apparent
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression preferences
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_prefer_braces = true:warning
csharp_using_directive_placement = outside_namespace:warning

# Modifiers
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
csharp_preferred_modifier_order = public,private,protected,internal,static,extern,new,virtual,abstract,sealed,override,readonly,unsafe,volatile,async:warning

# Nullable/quality rules we care about enough to keep at warning
dotnet_diagnostic.CA1848.severity = none   # LoggerMessage delegates — not worth it here

# New in the .NET 10 analyzers, and the same family as CA1848 above. Our logging sits on cold paths
# — startup, one call per segment, one per snapshot build — so guarding each call with IsEnabled
# would add noise to every log statement in the project to save nothing measurable. Kept off for the
# same reason Jellyfin's own ruleset turns off CA1848.
dotnet_diagnostic.CA1873.severity = none
dotnet_diagnostic.CA1031.severity = none   # we deliberately catch broad exceptions at task boundaries
dotnet_diagnostic.SA1633.severity = none   # file header
dotnet_diagnostic.SA1101.severity = none   # 'this.' prefix
dotnet_diagnostic.SA1309.severity = none   # allow _fieldName
dotnet_diagnostic.SA1413.severity = none   # trailing comma in multi-line initializers
