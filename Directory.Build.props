<Project>

  <PropertyGroup>
    <!-- CI overrides these: -p:Version=$V -p:AssemblyVersion=$V -p:FileVersion=$V -->
    <Version>0.0.0.0</Version>
    <AssemblyVersion>0.0.0.0</AssemblyVersion>
    <FileVersion>0.0.0.0</FileVersion>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <Authors>Gunnar Beutner</Authors>
    <Company>Gunnar Beutner</Company>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/gunnarbeutner/AureliaSync</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Deterministic, reproducible output. Matters because the release workflow
         asserts the published asset's MD5 against the manifest. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
