<Project>

  <PropertyGroup>
    <!--
      Packaging passes -p:Version=<release version>, which arrives as an MSBuild global property
      and so wins over the default below. AssemblyVersion and FileVersion must be derived from it
      rather than pinned: Jellyfin reads the assembly version for Plugin.Version and compares it
      when deciding whether an update applies, so a hardcoded 0.0.0.0 would report the wrong
      version and break the upgrade path.
    -->
    <Version>0.0.0.0</Version>
    <AssemblyVersion>$(Version)</AssemblyVersion>
    <FileVersion>$(Version)</FileVersion>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>

    <Authors>Gunnar Beutner</Authors>
    <Company>Gunnar Beutner</Company>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/gunnarbeutner/AureliaSync</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Deterministic, reproducible output. Matters because the release workflow
         asserts the published asset's MD5 against the manifest. -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
